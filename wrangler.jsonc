{
  // Cloudflare Workers (static assets). Only dist/ is published.
  // Build:   node scripts/build-dist.js
  // Deploy:  npx wrangler deploy        (non-production branches: npx wrangler versions upload)
  "name": "christianityapparently-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
